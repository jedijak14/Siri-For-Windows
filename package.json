{
  "name": "siri-for-windows",
  "version": "2.1.0",
  "private": true,
  "description": "A local-first Windows AI assistant powered by Ollama",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win portable",
    "build:win:installer": "electron-builder --win nsis",
    "dev": "node tools/preview.js",
    "build:android": "cd android && gradle assembleDebug"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "local.siriforwindows.assistant",
    "productName": "Siri for Windows",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "assets/siri.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Siri-for-Windows-${version}-${arch}.${ext}"
  },
  "author": "Siri for Windows contributors"
}
