<Window x:Class="SiriNative.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Siri for Windows" Width="1140" Height="800" MinWidth="840" MinHeight="560" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="#293C4E" BorderThickness="0,0,1,0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#152F49" Offset="0"/><GradientStop Color="#0E1C2A" Offset="0.5"/><GradientStop Color="#142131" Offset="1"/></LinearGradientBrush></Border.Background>
   <DockPanel Margin="15,20,14,14">
    <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,23"><Image Source="Assets/siri-logo.png" Width="30" Height="30"/><TextBlock Text="Siri" FontSize="21" Margin="11,1,0,0"/></StackPanel><Button Content="＋  New conversation" Click="NewChat" HorizontalContentAlignment="Left" Margin="0,0,0,12"/><TextBox x:Name="HistorySearch" TextChanged="FilterHistory" ToolTip="Search conversations" Margin="0,0,0,16"/><TextBlock Text="CONVERSATIONS" FontSize="9" Foreground="#92ABC0" Margin="3,0,0,10"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="WakeStatus" Text="○  Hey Siri is off" Foreground="#9EB4C5" FontSize="11" Margin="3,13,0,7"/><TextBlock x:Name="ModelStatus" Text="Checking local model…" Foreground="#899CA9" FontSize="10" TextWrapping="Wrap" Margin="3,0,0,12"/><Button Content="Choose model…" Click="ModelsClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="3,7"/><Button Content="Settings &amp; privacy" Click="SettingsClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="3,7"/></StackPanel>
    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="#DDEAF5" SelectionChanged="SelectConversation" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Turns.Count, StringFormat={}{0} replies}" FontSize="10" Foreground="#8CA3B7" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,16,28,14">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="ToolsButton" Content="Tools  ⋯" Click="OpenTools" DockPanel.Dock="Right" Margin="0" Background="#1A2836"/><TextBlock x:Name="ConversationTitle" Text="Siri" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/></DockPanel>
   <Grid Grid.Row="1"><ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,16"><StackPanel x:Name="Messages"/></ScrollViewer><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><Image Source="Assets/siri-logo.png" Width="70" Height="70" Opacity="0.45"/><TextBlock Text="What can I help you with?" Foreground="#9BAAB8" FontSize="17" Margin="0,22,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
   <StackPanel Grid.Row="2"><WrapPanel x:Name="Attachments" Margin="0,0,0,8"/><Border Background="#1A242F" CornerRadius="18" BorderBrush="#3A4958" BorderThickness="1" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Prompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45" MaxHeight="135" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="3,6" ToolTip="Ask Siri. Enter to send; Shift+Enter for a new line." PreviewKeyDown="PromptKeyDown"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="＋" Click="AttachFile" Padding="9,6" ToolTip="Attach an image or exported text"/><Button Content="♩" Click="Dictate" Padding="9,6" ToolTip="One-shot Windows dictation"/><Button x:Name="StopButton" Content="Stop" Click="Stop" Visibility="Collapsed"/><Button x:Name="SendButton" Content="↑" Click="Send" Padding="12,6" Margin="0"/></StackPanel></Grid></Border></StackPanel>
   <TextBlock x:Name="Status" Grid.Row="3" Foreground="#8B9FAE" FontSize="10" Text="Local processing · Review important answers" TextWrapping="Wrap" Margin="5,9,0,0"/>
  </Grid>
 </Grid>
</Window>
